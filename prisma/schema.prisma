// NEXUS 博客全栈化数据模型
// 设计依据：用户/评论/点赞/统计，文章本体保留 MDX 文件，用 lang + slug 关联

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  READER
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(50)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  role         Role     @default(READER)
  status       Int      @default(1) // 1 正常 0 封禁
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  comments Comment[]
  posts    Post[]

  @@map("users")
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  postLang  String   @map("post_lang") @db.Char(2)
  postSlug  String   @map("post_slug") @db.VarChar(200)
  userId    BigInt   @map("user_id")
  parentId  BigInt?  @map("parent_id")
  content   String   @db.VarChar(1000)
  status    Int      @default(1) // 1 可见 0 已删除
  createdAt DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([postLang, postSlug, createdAt])
  @@index([parentId])
  @@map("comments")
}

model PostLike {
  id        BigInt   @id @default(autoincrement())
  postLang  String   @map("post_lang") @db.Char(2)
  postSlug  String   @map("post_slug") @db.VarChar(200)
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postLang, postSlug, userId])
  @@map("post_likes")
}

model PostStat {
  postLang  String   @map("post_lang") @db.Char(2)
  postSlug  String   @map("post_slug") @db.VarChar(200)
  views     BigInt   @default(0)
  likes     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([postLang, postSlug])
  @@map("post_stats")
}

// 在线写作的文章（与 content/ 下 MDX 文章并存，本地文件同名时优先）
model Post {
  id        BigInt   @id @default(autoincrement())
  lang      String   @db.Char(2)
  slug      String   @db.VarChar(200)
  title     String   @db.VarChar(200)
  summary   String   @db.VarChar(500)
  category  String   @db.VarChar(20) // tech | life | essay
  tags      Json? // string[]
  content   String   @db.Text // Markdown 正文（无 frontmatter）
  authorId  BigInt   @map("author_id")
  status    Int      @default(1) // 1 可见 0 隐藏
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@unique([lang, slug])
  @@map("posts")
}

// 写作时上传的图片：二进制直接存 MySQL，通过 /api/v1/media/{id} 读取。
// 之所以不走 public/：本项目部署在 Vercel，serverless 文件系统只读且不提供运行时新增的静态文件。
model Media {
  id         BigInt   @id @default(autoincrement())
  filename   String   @db.VarChar(200)
  mimeType   String   @map("mime_type") @db.VarChar(50)
  byteSize   Int      @map("byte_size")
  data       Bytes    @db.LongBlob
  uploaderId BigInt   @map("uploader_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([uploaderId])
  @@map("media")
}

// 可供管理员在页面上直接编辑的站点文案，按 key + lang 存一段 JSON。
// 没有记录时页面回落 lib/i18n.ts 里的默认值 —— 所以这张表为空也不影响渲染。
model SiteContent {
  key       String   @db.VarChar(64) // 如 "about"
  lang      String   @db.Char(2)
  value     String   @db.Text // JSON
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([key, lang])
  @@map("site_content")
}
