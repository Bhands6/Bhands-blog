# 复制为 deploy/env.production 并填写。
# compose 用 --env-file 读它做变量替换，app 容器也经 env_file 注入同一份。
# 含密钥，不要提交进仓库（.gitignore 已排除 deploy/env.production）。

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=改成强密码
MYSQL_DATABASE=bhands_blog
# 应用连接账号：沿用本地开发的用户名，迁移数据时 dump 无需改动
MYSQL_USER=nexus
MYSQL_PASSWORD=改成强密码

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=改成强密码

# ── 应用 ──────────────────────────────────────────────────────
# JWT 签名密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：浏览量去重键（hashIp）也用它。迁移后换新密钥只影响当天去重，无碍。
JWT_SECRET=生成一个64位hex
# 浏览量兜底回写接口（crontab 调用时带 Bearer 头）
CRON_SECRET=生成一个随机串
# 站点对外地址：构建期内嵌进静态产物（feed/sitemap/OG），改动后需重新构建
NEXT_PUBLIC_SITE_URL=https://blog.bhands.me
